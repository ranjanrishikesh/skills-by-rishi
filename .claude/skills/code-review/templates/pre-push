#!/usr/bin/env bash
# THE AUTHORITATIVE PUBLISH GATE.
#
# Git runs this on the real publish, after the shell has already resolved
# quoting, command substitution, heredocs, aliases and escapes. It therefore
# cannot be fooled by how the command was typed, which a string matcher
# demonstrably could: three review cycles each found a new bypass (command
# substitution inside quotes, heredoc bodies, a backslash-escaped command name,
# ANSI-C quoting, and branch names containing an excluded keyword). All of them
# executed for real.
#
# Because git invokes this itself, with no agent involved, enforcement is
# identical under every agent, in a bare terminal, and in CI. The PreToolUse
# hook is advisory only and covers `gh pr create`, which no git hook sees.
#
# Written by the code-review skill's installer. Re-run the installer to update
# it. Bypassing requires --no-verify, which is a deliberate and visible act.

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$ROOT" ] || exit 0

CHECKS="$ROOT/__SKILL_DIR__/scripts/publish-checks.mjs"

# Fail OPEN when the machinery itself is absent, and only then. A clone that has
# not installed the skill, or a machine with no node, is not the same thing as a
# change set that failed review: refusing there would brick a repository over a
# missing tool rather than over anything anyone wrote. Everything the gate
# actually judges fails CLOSED, inside publish-checks.mjs.
if [ ! -f "$CHECKS" ]; then
  echo "[pre-push] $CHECKS missing; skipping checks (fail-open)." >&2
  exit 0
fi
if ! command -v node >/dev/null 2>&1; then
  echo "[pre-push] node not found; skipping checks (fail-open)." >&2
  exit 0
fi

CLAUDE_PROJECT_DIR="$ROOT" node "$CHECKS"
STATUS=$?
if [ "$STATUS" -ne 0 ]; then
  echo "" >&2
  echo "[pre-push] refused." >&2
  exit 1
fi
exit 0
